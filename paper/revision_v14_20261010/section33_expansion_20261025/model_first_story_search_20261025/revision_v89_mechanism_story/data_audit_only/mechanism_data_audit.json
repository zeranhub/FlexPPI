  "claim_audit": [
    {
      "claim": "W303–M316 anchor span has continuous low bound-state backbone fluctuation",
      "judgement": "supported",
      "basis": "Full 14/14 RMSF are 0.447–0.689 A; MD 14/14 are 0.453–0.624 A. These values are lower than native N-flank and two-residue tail means in Full and full-trajectory MD.",
      "limitation": "Low RMSF measures positional fluctuations under the used alignment, not alpha-helix content or binding kinetic lifetime."
    },
    {
      "claim": "K296/F298 are more mobile than the central anchor span",
      "judgement": "qualified support",
      "basis": "K296 Full/MD 1.010/1.216 A; F298 0.626/0.874 A; central mean 0.513/0.553 A. F298 has only modest Full RMSF elevation and lies within the whole central Full range.",
      "limitation": "Do not label the whole K296/F298 pair as a sharply distinct flexible latch. Their involvement in autoinhibition requires literature or separate 1A06 structure, not their RMSF alone."
    },
    {
      "claim": "The C terminus retains relative flexibility in the bound complex",
      "judgement": "qualified support",
      "basis": "R317/K318 Full RMSF 0.778/1.064 A, MD 0.768/1.771 A; the increase is strongest at K318. Tail-versus-core mean direction is positive in all five MD windows.",
      "limitation": "Only two tail residues, substantial time-window variation, and no measured terminal–domain coupling. A functional flexible leash or domain engagement mechanism remains a hypothesis."
    },
    {
      "claim": "F298 and F307 illustrate distinct backbone/sidechain readouts",
      "judgement": "supported descriptive contrast",
      "basis": "Same Phe type: F298/F307 Full RMSF 0.626/0.447 A, MD 0.874/0.511 A, whereas Hchi Full 1.033/0.996 nats, MD 1.406/1.418 nats. Backbone difference does not require greater sidechain entropy.",
      "limitation": "Five-window backbone difference direction and Hchi direction are exported separately; no independent-repeat p-values are claimed."
    },
    {
      "claim": "Partner context constrains bound peptide compared with a real free peptide",
      "judgement": "not measured by Full/Intra",
      "basis": "Both separately trained models used the same bound structure and bound MD target; Intra is the within-chain model. Full/Intra values cannot be substituted for two physical binding states.",
      "limitation": "Use partner-aware versus within-chain prediction labels, not bound/free or before/after CaM."
    },
    {
      "claim": "Residual helix in free peptide, conformational selection plus folding funnel, or a C-first N-second temporal pathway",
      "judgement": "hypotheses only; unsupported by these readouts",
      "basis": "No free peptide trajectory, secondary-structure time series, transitions, ensemble reweighting, or time-resolved domain engagement data are provided.",
      "limitation": "Intra predictions of low central RMSF are not proof of residual helix. Static lobe contacts cannot establish order of engagement."
    },
    {
      "claim": "CaM restrains the regulatory segment and reduces return to autoinhibitory contacts",
      "judgement": "mechanistic hypothesis consistent with bound-state spatial fluctuation pattern and prior static/literature context",
      "basis": "A low-fluctuation anchor span and actual lobe contacts provide a plausible retained-segment geometry.",
      "limitation": "1MXE lacks catalytic domain, and no binding/unbinding or regulatory-segment reinsertion event is measured. Do not claim measured reduced return probability or activity."
    },
    {
      "claim": "RMSF/Hchi establish binding free energy, rotational speed, residence time or activation rate",
      "judgement": "not inferable",
      "basis": "RMSF is positional amplitude and Hchi is fixed-bin joint torsional occupancy entropy, each lacking transition timing and energetic reference.",
      "limitation": "MD window variability is not confidence interval from independent replicas."
    }
  ],
  "window_note": "Five consecutive 100 ns windows from one 500 ns trajectory, not independent repeats. Full-trajectory RMSF target is exported as frozen_rmsf in window source and must not be replaced with arithmetic average of separately calculated window RMSF values.",
